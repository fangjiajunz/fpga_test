set_location_assignment PIN_N11 -to seg_led[5]
set_location_assignment PIN_P11 -to seg_led[6]
set_location_assignment PIN_D9 -to seg_led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_led[7]

# USB UART
